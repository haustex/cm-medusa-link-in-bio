{
  "name": "medusa-link-in-bio",
  "version": "0.2.1",
  "description": "Link-in-bio pages for Medusa v2: profile with uploaded avatar or hero image, drag-and-drop links, live products with price and stock, collections, promo codes, blog posts, WhatsApp, scheduling, per-locale text, click counts without cookies, UTM, styled QR codes with logo (light/dark), typed Store API — by Haus Kayu",
  "author": "Haus Kayu <dev@hauskayu.com> (https://hauskayu.com)",
  "license": "MIT",
  "homepage": "https://github.com/haustex/cm-medusa-link-in-bio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haustex/cm-medusa-link-in-bio.git"
  },
  "bugs": {
    "url": "https://github.com/haustex/cm-medusa-link-in-bio/issues",
    "email": "dev@hauskayu.com"
  },
  "funding": "https://hauskayu.com",
  "files": [
    ".medusa/server",
    "!.medusa/server/**/__tests__",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "provenance": true
  },
  "exports": {
    "./package.json": "./package.json",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./sdk": "./.medusa/server/src/sdk.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "link-in-bio",
    "bio-link",
    "linktree",
    "social-commerce",
    "instagram",
    "tiktok",
    "qr-code",
    "utm",
    "click-tracking",
    "privacy",
    "i18n"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "test": "jest",
    "test:unit": "jest",
    "guard": "node scripts/guard.mjs",
    "db:generate": "node scripts/guard.mjs medusa plugin:db:generate",
    "prepublishOnly": "medusa plugin:build",
    "pack:check": "node scripts/check-pack.mjs",
    "test:e2e": "node integration-tests/e2e.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "isbot": "^5.2.3",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/eslint-plugin": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/test-utils": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jiti": "^2.0.0",
    "jsqr": "^1.4.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.19.0",
    "@medusajs/cli": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/icons": "^2.19.0",
    "@medusajs/js-sdk": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/ui": "^4.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@10.9.9"
}
